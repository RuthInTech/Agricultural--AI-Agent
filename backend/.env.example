# Django Settings
DJANGO_SECRET_KEY=django-insecure-replace-this-in-production-with-a-secure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database Configuration (PostgreSQL / Supabase / Neon or leave empty for SQLite)
DATABASE_URL=postgresql://postgres:password@localhost:5432/agri_db

# Optional direct DB connection parameters if DATABASE_URL is not set
DB_NAME=agri_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Free-Tier AI Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Weather Provider Configuration (Optional OpenWeatherMap key, or uses Open-Meteo keyless fallback)
weather_app=your_weather_api_key_here
OPENWEATHERMAP_API_KEY=your_weather_api_key_here

# Frontend CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
