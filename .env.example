# ---------------------------------------------------------------------------
# AgriGuide — environment template. COPY to `.env` (backend) and fill in.
# This file contains PLACEHOLDERS ONLY. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Backend (Django) — backend/.env ---------------------------------------
# Generate a real key for anything non-local:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
# Comma-separated origins allowed to call the API (the Vite dev server):
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Both default to "allow everything" so no host/origin is ever blocked:
#   CORS_ALLOW_ALL_ORIGINS=true    -> every browser origin may call the API
#   DJANGO_ALLOW_ALL_HOSTS=true    -> any Host header is accepted
# Set either to false to enforce the two lists above.
CORS_ALLOW_ALL_ORIGINS=true
DJANGO_ALLOW_ALL_HOSTS=true

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL EMPTY to fall back to local SQLite (dev/tests only).
# For PostgreSQL (the required production DB), set a full URL. The database
# must already exist and the role must have create rights on it, e.g.:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
# Local socket example:
#   postgres://postgres@/agriguide?host=/var/run/postgresql
DATABASE_URL=

# --- AI (free-tier LLM) -----------------------------------------------------
# Google Gemini free tier (AI Studio). Leave EMPTY to use the built-in
# rule-based advisory fallback (fully offline, no external calls).
# Get a key at https://aistudio.google.com/ (free tier). Verify free-tier
# availability and rate limits for your region before relying on it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend (Vite) — frontend/.env.local ---------------------------------
# Base URL the React app uses to reach the Django backend API:
VITE_API_BASE_URL=http://127.0.0.1:8000/api
